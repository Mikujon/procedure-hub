# --- Docker services (Postgres/MeiliSearch/Redis) ---
# Credentials live in .env.docker (gitignored), not here — see docker-compose.yml.
# Generate it once with:
#   POSTGRES_PASSWORD=...
#   MEILI_MASTER_KEY=...
#   REDIS_PASSWORD=...
# Then: docker compose --env-file .env.docker up -d
# The three values below must match what you put in .env.docker.

# --- Database ---
DATABASE_URL="postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/procedure_hub?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand--base64-32"

# --- Microsoft Entra ID / Azure AD SSO (optional — leave blank to disable) ---
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# --- Search (MeiliSearch) ---
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="REPLACE_WITH_MEILI_MASTER_KEY"

# --- Redis (job queue for async fan-out: notifications, future AI/media jobs) ---
REDIS_URL="redis://:REPLACE_WITH_REDIS_PASSWORD@localhost:6379"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cron (GET /api/cron/review-reminders, see vercel.json) ---
# Leave blank in local dev. Set before deploying publicly, and configure the
# same value as the Authorization: Bearer header Vercel Cron sends.
CRON_SECRET=""

# --- Block engine real-time collaboration (Hocuspocus, collab-server/) ---
COLLAB_JWT_SECRET="replace-with-openssl-rand--base64-32"
COLLAB_SERVER_PORT="1234"
NEXT_PUBLIC_COLLAB_URL="ws://localhost:1234"

# --- Read & Acknowledge escalation (Fase 4) ---
# Signs the one-click confirm links sent via Slack/Google Chat/email.
ACK_JWT_SECRET="replace-with-openssl-rand--base64-32"

# --- AI (Fase 5a foundation, Fase 5 features) — src/lib/ai/client.ts ---
# Currently Gemini (free tier) via @google/genai. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Email (Resend) — used for digest / mention emails ---
RESEND_API_KEY=""

# --- Object storage for attachments (S3-compatible) ---
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""

# --- Slack integration (tenant-level values are stored in the Integration
#     table's config JSON via the admin UI; these are only needed if you
#     build the OAuth "Add to Slack" install flow) ---
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# --- Google Chat / Google Workspace (for bot-mode DMs & future Entra-style
#     Workspace SSO); webhook mode needs no server-side secret at all ---
GOOGLE_SERVICE_ACCOUNT_JSON=""
